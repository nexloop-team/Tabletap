# Copy to .env.local (never commit real values).

# PostgreSQL. Leave empty locally to use the embedded database in ./data/pg.
# Supabase: Project → Connect → Session pooler string, with your password.
DATABASE_URL=
# DATABASE_SSL=off        # only for a self-hosted server without TLS
# DATABASE_POOL_SIZE=5

# Images and feedback photos in an S3-compatible bucket (Supabase Storage, MinIO, R2, AWS).
# Leave empty to keep them on this server's disk under ./data.
# Supabase: Storage → Settings → S3 access keys; endpoint https://<project>.supabase.co/storage/v1/s3
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI menu import and dish notes
GROQ_API_KEY=
